---
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';
import { render, type CollectionEntry } from 'astro:content';
import {
  type Section,
  type PaintingCollection,
  categoryLabel,
} from '../config/sections';
import { ogImagePath } from '../utils/og';
import { formatSize } from '../utils/size';

interface Props {
  section: Section;
  painting: CollectionEntry<PaintingCollection>;
}

const { section, painting } = Astro.props;
const { Content } = await render(painting);
const { title, date, location, medium, width, height, category, cover, images } = painting.data;

const size = formatSize(width, height);

// The cover doubles as the main image so it never has to be entered twice.
// Drop it from `images` if it was also listed there, to avoid a duplicate.
const gallery = cover ? [cover, ...images.filter((src) => src !== cover)] : images;

const formattedDate = date
  ? new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long' }).format(date)
  : null;
---

<Layout title={title} description={medium || section.title} image={ogImagePath(cover)}>
  <article class="painting">
    <h1 class="painting-title">{title}</h1>

    <div class="painting-layout">
      <div class="painting-main">
        {gallery[0] && (
          <button class="painting-image" data-index={0} type="button">
            <img src={gallery[0]} alt={title} />
          </button>
        )}
      </div>

      <div class="painting-info">
        <ul class="painting-meta">
          {medium && <li><strong>Medium:</strong> {medium}</li>}
          {size && <li><strong>Size:</strong> {size}</li>}
          {formattedDate && <li><strong>Date:</strong> {formattedDate}</li>}
          {location && <li><strong>Location:</strong> {location}</li>}
        </ul>
        <div class="painting-body"><Content /></div>
      </div>
    </div>

    {gallery.length > 1 && (
      <div class="painting-more">
        {gallery.slice(1).map((src, i) => (
          <button class="painting-image" data-index={i + 1} type="button">
            <img src={src} alt={`${title} (${i + 2})`} loading="lazy" />
          </button>
        ))}
      </div>
    )}
  </article>

  <Lightbox images={gallery} alt={title} />
</Layout>

<style>
  .painting {
    padding: 0 var(--margin);
    max-width: var(--large);
    margin: 0 auto;
  }
  .painting-title {
    font-family: var(--font-serif);
    font-size: 3.6rem;
    /* No back link sits above it any more. */
    margin: 2rem 0 4rem;
  }
  .painting-layout {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 3rem;
    align-items: start;
  }
  .painting-main {
    position: sticky;
    top: 2rem;
  }
  .painting-meta {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.7rem;
  }
  .painting-meta li {
    margin: 0;
    padding: 0;
    line-height: 1.5;
  }
  .painting-body {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1.6;
  }
  .painting-more {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  @media (max-width: 800px) {
    .painting-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .painting-main {
      position: static;
    }
  }
  .painting-image {
    display: block;
    width: 100%;
    height: fit-content;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .painting-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
  }
</style>
