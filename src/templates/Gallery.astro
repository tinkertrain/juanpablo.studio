---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { resolveImage } from '../utils/images';
import {
  type Section,
  type PaintingCollection,
  categoryLabel,
  categoryUrl,
  sectionUrl,
  paintingUrl,
  sectionForCollection,
} from '../config/sections';

interface Props {
  section: Section;
  paintings: CollectionEntry<PaintingCollection>[];
  categories: string[];
  activeCategory: string | null;
}

const { section, paintings, categories, activeCategory } = Astro.props;

const thumb = (p: Props['paintings'][number]) => p.data.cover || p.data.images[0];

// A cross-listed piece links to its home section, where its page actually is.
const href = (p: Props['paintings'][number]) => {
  const home = sectionForCollection(p.collection) ?? section;
  return paintingUrl(home, p.id, p.data.category);
};
---

<Layout title={section.title} description={`${section.title} by the artist`}>
  <section class="gallery">
    <h1 class="gallery-title">{section.title}</h1>

    {section.hasCategories && categories.length > 0 && (
      <nav class="gallery-filters" aria-label="Filter by medium">
        <a
          href={sectionUrl(section)}
          class={`gallery-chip ${activeCategory ? '' : 'is-active'}`}
        >
          All
        </a>
        {categories.map((cat) => (
          <a
            href={categoryUrl(section, cat)}
            class={`gallery-chip ${activeCategory === cat ? 'is-active' : ''}`}
          >
            {categoryLabel(cat)}
          </a>
        ))}
      </nav>
    )}

    {paintings.length === 0 ? (
      <p class="gallery-empty">No pieces here yet.</p>
    ) : (
      <div class="masonry">
        {paintings.map((p) => (
          <a class="masonry-item" href={href(p)}>
            {/* One column at 480px, two to 980px, three above: the widest a
                thumbnail ever gets is about half the 1680px content column. */}
            <Image
              src={resolveImage(thumb(p))}
              alt={p.data.title}
              widths={[400, 600, 900]}
              sizes="(max-width: 480px) 100vw, (max-width: 980px) 50vw, 33vw"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .gallery {
    padding: 0 var(--margin);
    max-width: var(--xlarge);
    margin: 0 auto;
  }
  .gallery-title {
    font-family: var(--font-serif);
    font-size: 3.6rem;
    margin: 2rem 0 4rem;
  }
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 4rem;
  }
  .gallery-chip {
    padding: 3px 30px;
    border: 2px solid var(--color-chip-border);
    border-radius: 40px;
    font-size: 1.5rem;
    text-decoration: none;
    color: var(--color-chip-text);
  }
  .gallery-chip.is-active {
    background: var(--color-chip-bg-active);
    color: var(--color-chip-text-active);
    border-color: var(--color-chip-border-active);
  }
  .masonry {
    column-count: 3;
    column-gap: 1rem;
  }
  .masonry-item {
    display: block;
    position: relative;
    break-inside: avoid;
    margin-bottom: 1rem;
    text-decoration: none;
  }
  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
  }
  .gallery-empty {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--color-base);
  }
  @media (max-width: 980px) {
    .masonry { column-count: 2; }
  }
  @media (max-width: 480px) {
    .masonry { column-count: 1; }
  }
</style>
