---
import "../styles/vars.css";
import "../styles/base.css";
import "../styles/layout.css";

import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const { title, description, image } = Astro.props;

const pageTitle = title || "Juan Pablo";
const pageDescription = description || "Painter, urban sketcher, plein air artist";
// Social scrapers (WhatsApp, iMessage, Slack, Facebook) require an absolute URL.
const ogImage = new URL(image || "/img/usk_bg.jpg", Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const FONTS_HREF =
    "https://fonts.googleapis.com/css2?family=Averia+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=League+Spartan:wght@300;400;500;600;700&family=Permanent+Marker&display=swap";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={pageDescription} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="canonical" href={canonical} />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Juan Pablo" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={ogImage} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>

        {/* Loaded here rather than through an @import inside the CSS, which
            could not start fetching until the stylesheet had been parsed. */}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={FONTS_HREF} />

        <ClientRouter />
        <script is:inline>
            // The one place the theme rule lives: a saved choice wins, otherwise
            // follow the OS. Defined and applied before paint so the first render
            // is already the right colour, then reused by the toggle below and
            // after every view transition.
            window.__theme = {
                preferred() {
                    return (
                        localStorage.getItem("theme") ||
                        (window.matchMedia("(prefers-color-scheme: dark)")
                            .matches
                            ? "dark"
                            : "light")
                    );
                },
                apply(theme) {
                    const root = document.documentElement;
                    if (theme === "dark") {
                        root.setAttribute("data-theme", "dark");
                    } else {
                        root.removeAttribute("data-theme");
                    }
                },
            };
            window.__theme.apply(window.__theme.preferred());
        </script>
    </head>
    <body class="site-wrapper">
        <Header />

        <main id="site-main" class="site-main">
            <slot />
        </main>

        <Footer />

        <script>
            const theme = window.__theme;

            // Follow live OS changes until the user picks a theme. Registered at
            // module scope, which runs once, unlike the per-page wiring below.
            window
                .matchMedia("(prefers-color-scheme: dark)")
                .addEventListener("change", () => {
                    if (localStorage.getItem("theme")) return;
                    theme.apply(theme.preferred());
                });

            // A client-side navigation swaps <html>, taking the attribute with it.
            document.addEventListener("astro:after-swap", () =>
                theme.apply(theme.preferred()),
            );

            // The header is replaced on every transition, so its listeners have
            // to be attached again each time. Fires on the initial load too.
            document.addEventListener("astro:page-load", () => {
                const wrapper = document.querySelector(".site-wrapper");
                const burger = document.querySelector(".nav-burger");
                burger?.addEventListener("click", () => {
                    const open = wrapper?.classList.toggle("site-head-open");
                    burger.setAttribute("aria-expanded", String(!!open));
                });

                document
                    .getElementById("theme-toggle")
                    ?.addEventListener("click", () => {
                        const next =
                            document.documentElement.getAttribute(
                                "data-theme",
                            ) === "dark"
                                ? "light"
                                : "dark";
                        theme.apply(next);
                        localStorage.setItem("theme", next);
                    });
            });
        </script>
    </body>
</html>
