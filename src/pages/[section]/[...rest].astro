---
import { getCollection, type CollectionEntry } from 'astro:content';
import Gallery from '../../templates/Gallery.astro';
import PaintingDetail from '../../templates/PaintingDetail.astro';
import {
  SECTIONS,
  type PaintingCollection,
  filterPaintings,
  availableCategories,
  crossListedInto,
} from '../../config/sections';

type Painting = CollectionEntry<PaintingCollection>;

export async function getStaticPaths() {
  const byDateDesc = (a: Painting, b: Painting) =>
    new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime();

  const paths: any[] = [];

  // Every piece, so a section's gallery can pick up cross-listed ones.
  const everything = (
    await Promise.all(
      SECTIONS.map((s) => getCollection(s.collection) as Promise<Painting[]>),
    )
  ).flat();

  for (const section of SECTIONS) {
    const own = everything.filter((p) => p.collection === section.collection);

    // Guests show in the gallery; only `own` gets a detail page, so a
    // cross-listed piece keeps exactly one canonical URL.
    const paintings = [...own, ...crossListedInto(section, everything)].sort(
      byDateDesc,
    );

    // Only offer filters for mediums that actually have paintings.
    const categories = availableCategories(section, paintings);

    // Section index (rest undefined => /studio-paintings)
    paths.push({
      params: { section: section.slug, rest: undefined },
      props: {
        kind: 'index',
        section,
        paintings,
        categories,
        activeCategory: null,
      },
    });

    // Category filters
    for (const category of categories) {
      paths.push({
        params: { section: section.slug, rest: category },
        props: {
          kind: 'index',
          section,
          paintings: filterPaintings(paintings, category),
          categories,
          activeCategory: category,
        },
      });
    }

    // Painting details
    for (const painting of own) {
      const rest =
        section.hasCategories && painting.data.category
          ? `${painting.data.category}/${painting.id}`
          : painting.id;
      paths.push({
        params: { section: section.slug, rest },
        props: { kind: 'detail', section, painting },
      });
    }
  }

  return paths;
}

const props = Astro.props as any;
---

{
  props.kind === 'detail' ? (
    <PaintingDetail section={props.section} painting={props.painting} />
  ) : (
    <Gallery
      section={props.section}
      paintings={props.paintings}
      categories={props.categories}
      activeCategory={props.activeCategory}
    />
  )
}
